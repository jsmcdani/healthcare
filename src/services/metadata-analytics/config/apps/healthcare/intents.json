{
  "appId": "healthcare",
  "version": "1.0.0",

  "intents": [
    {
      "id": "hc:patient-summary",
      "tier": "1",
      "description": "Retrieve and summarize patient information with clinical context",
      "triggers": ["/patient", "/patient-summary", "/summary"],
      "entities": {
        "patientId": { "type": "string", "extractFrom": "args", "required": true }
      },
      "patterns": [
        { "regex": "(?:show|get|view|find)\\s+(?:patient|pt)\\s+([A-Za-z0-9-]+)", "weight": 0.95, "groups": { "patientId": 1 } },
        { "regex": "patient\\s+(?:summary|info|details|record)\\s+(?:for\\s+)?([A-Za-z0-9-]+)", "weight": 0.95, "groups": { "patientId": 1 } },
        { "regex": "(?:who\\s+is|look\\s+up)\\s+(?:patient\\s+)?([A-Za-z0-9-]+)", "weight": 0.95, "groups": { "patientId": 1 } },
        { "regex": "([A-Za-z0-9-]+)\\s+patient\\s+(?:summary|info)", "weight": 0.9, "groups": { "patientId": 1 } }
      ],
      "recipe": "patient-summary",
      "confidenceThreshold": 0.8,
      "mode": "CLINICAL_DECISION_SUPPORT"
    },
    {
      "id": "hc:treatment-recommendation",
      "tier": "1",
      "description": "Provide evidence-based treatment recommendations with clinical guidelines",
      "triggers": ["/treatment", "/treat", "/therapy", "/recommend"],
      "entities": {
        "condition": { "type": "string", "extractFrom": "args", "required": true }
      },
      "patterns": [
        { "regex": "treatment\\s+(?:for|of)\\s+(.+)", "weight": 0.95, "groups": { "condition": 1 } },
        { "regex": "(?:how\\s+(?:to|should\\s+(?:I|we)))\\s+treat\\s+(.+)", "weight": 0.95, "groups": { "condition": 1 } },
        { "regex": "(?:therapy|medication)\\s+(?:for|recommendation)\\s+(.+)", "weight": 0.9, "groups": { "condition": 1 } },
        { "regex": "(?:recommend|suggest)\\s+(?:treatment|therapy)\\s+(?:for\\s+)?(.+)", "weight": 0.9, "groups": { "condition": 1 } },
        { "regex": "(diabetes|hypertension|copd|asthma|depression|anxiety)\\s+(?:treatment|management|therapy)", "weight": 0.9, "groups": { "condition": 1 } }
      ],
      "recipe": "treatment-recommendation",
      "confidenceThreshold": 0.8,
      "mode": "CLINICAL_DECISION_SUPPORT"
    },
    {
      "id": "hc:care-gaps",
      "tier": "1",
      "description": "Identify care gaps and overdue screenings for a patient",
      "triggers": ["/care-gaps", "/gaps", "/screenings"],
      "entities": {
        "patientId": { "type": "string", "extractFrom": "args", "required": true }
      },
      "patterns": [
        { "regex": "care\\s+gaps?\\s+(?:for\\s+)?(?:patient\\s+)?([A-Za-z0-9-]+)", "weight": 0.95, "groups": { "patientId": 1 } },
        { "regex": "(?:overdue|missing|needed)\\s+(?:screenings?|tests?|exams?)\\s+(?:for\\s+)?([A-Za-z0-9-]+)", "weight": 0.9, "groups": { "patientId": 1 } },
        { "regex": "(?:what|which)\\s+(?:screenings?|tests?)\\s+(?:are\\s+)?(?:due|needed|overdue)\\s+(?:for\\s+)?([A-Za-z0-9-]+)", "weight": 0.9, "groups": { "patientId": 1 } },
        { "regex": "([A-Za-z0-9-]+)\\s+care\\s+gaps?", "weight": 0.85, "groups": { "patientId": 1 } }
      ],
      "recipe": "care-gap-analysis",
      "confidenceThreshold": 0.8,
      "mode": "CLINICAL_DECISION_SUPPORT"
    },
    {
      "id": "hc:emergency-triage",
      "tier": "1",
      "description": "Emergency triage assessment for urgent situations",
      "triggers": ["/emergency", "/triage", "/urgent"],
      "entities": {
        "patientId": { "type": "string", "extractFrom": "args", "required": true },
        "chiefComplaint": { "type": "string", "extractFrom": "args", "required": false }
      },
      "patterns": [
        { "regex": "(?:emergency|urgent|stat)\\s+(?:triage|assessment)?\\s+(?:for\\s+)?([A-Za-z0-9-]+)", "weight": 0.95, "groups": { "patientId": 1 } },
        { "regex": "(?:code\\s+blue|cardiac\\s+arrest)\\s+(?:patient\\s+)?([A-Za-z0-9-]+)", "weight": 0.98, "groups": { "patientId": 1 } },
        { "regex": "([A-Za-z0-9-]+)\\s+(?:has|with)\\s+(chest\\s+pain|difficulty\\s+breathing|severe\\s+pain)", "weight": 0.95, "groups": { "patientId": 1, "chiefComplaint": 2 } }
      ],
      "recipe": "emergency-triage",
      "confidenceThreshold": 0.6,
      "mode": "EMERGENCY_TRIAGE"
    },
    {
      "id": "hc:help",
      "tier": "1",
      "description": "Show available healthcare commands",
      "triggers": ["/help", "/commands", "/?"],
      "patterns": [
        { "regex": "(?:what|show|list).*(?:can\\s+you\\s+do|commands?|help)", "weight": 0.9 },
        { "regex": "help", "weight": 0.8 }
      ],
      "recipe": "show-help",
      "confidenceThreshold": 0.8
    }
  ],

  "fallback": {
    "message": "I specialize in clinical decision support. Try commands like /patient MRN-12345, /treatment diabetes type 2, or /care-gaps MRN-12345. Type /help for all available commands.",
    "suggestions": ["/patient MRN-12345", "/treatment diabetes", "/care-gaps MRN-12345", "/help"]
  }
}
