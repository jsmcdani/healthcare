{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|WebFetch|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|mcp__.*)$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse-guard.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/record-gateway-result.mjs\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/record-gateway-result.mjs\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-receipt-check.mjs\"" }
        ]
      }
    ]
  }
}
