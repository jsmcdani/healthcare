{
  "name": "servient-platform",
  "version": "1.0.0",
  "description": "Enterprise AI Automation Platform - Unified Salesforce and Business Intelligence with MCP Architecture",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-server.js",
    "dev": "node scripts/start-dev.js",
    "dev:session": "node scripts/start-session.js --agent codex --task \"dev session\"",
    "dev:capsule": "node scripts/start-capsule-dev.js",
    "dev:watch": "nodemon src/index.js",
    "stop": "node scripts/stop-server.js",
    "setup": "node scripts/setup-database.js",
    "setup:docker": "docker-compose up -d && timeout 10 && npm run setup",
    "provision": "node scripts/provision-platform.js",
    "provision:full": "docker-compose up -d && node scripts/provision-platform.js",
    "provision:container": "bash scripts/provision-container.sh",
    "create-org": "node scripts/create-org.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration",
    "test:guard": "node --test plugins/gateway-guard/test/guard.test.mjs",
    "test:api": "node scripts/test-api.js",
    "test:label": "node scripts/test-label-api.js",
    "test:health": "node scripts/test-health.js",
    "test:quick": "npm run test:health && node scripts/validate-services.js",
    "test:commit": "node run-commit-tests.js",
    "test:all-endpoints": "node test-all-endpoints.js",
    "test:cluster": "node scripts/test-cluster-implementation.mjs",
    "setup:hooks": "node scripts/install-hooks.js",
    "check:compliance": "node scripts/pre-commit-check.js",
    "compliance:build": "node scripts/build-compliance-registries.js",
    "session:start": "node scripts/session-start.js",
    "postinstall": "node scripts/install-hooks.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "health": "echo Testing health...",
    "monitor:start": "node src/monitoring/start-monitoring.js",
    "monitor:dashboard": "node -e \"const {PerformanceDashboard}=require('./src/monitoring/PerformanceDashboard.js'); new PerformanceDashboard().saveDashboard('./performance-dashboard.html'); console.log('Dashboard saved to performance-dashboard.html');\"",
    "monitor:report": "node -e \"const service=require('./src/services/PerformanceMonitoringService.js'); service.generatePerformanceReport().then(r=>console.log(JSON.stringify(r,null,2)));\"",
    "monitor:alerts": "node -e \"const service=require('./src/services/PerformanceMonitoringService.js'); service.getActiveAlerts().then(a=>console.log(JSON.stringify(a,null,2)));\"",
    "scan:api": "node scripts/list-api-endpoints.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@api-modeling/amf-client-js": "^4.2.3",
    "@azure/cosmos": "^4.9.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/rest": "^22.0.1",
    "adm-zip": "^0.5.16",
    "arangojs": "^8.4.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "chalk": "^5.0.0",
    "commander": "^14.0.0",
    "compression": "^1.7.4",
    "connect-redis": "^7.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "csv-parser": "^3.0.0",
    "cytoscape": "^3.33.1",
    "docx": "^9.5.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.17.3",
    "fast-xml-parser": "^5.3.0",
    "gremlin": "^3.8.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^18.0.0",
    "js-yaml": "^4.1.0",
    "jsforce": "^1.11.1",
    "jsonwebtoken": "^9.0.2",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.2",
    "raml-1-parser": "^1.1.49",
    "rate-limit-redis": "^4.2.1",
    "redis": "^4.6.7",
    "resend": "^6.5.2",
    "uuid": "^9.0.1",
    "winston": "^3.10.0",
    "ws": "^8.14.2",
    "xml2js": "^0.6.2",
    "yaml": "^2.3.4",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "zod": "^4.3.6"
  }
}
